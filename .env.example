# Copy to .env and export before running. Never commit real secrets.
NODE_ENV=development
PORT=3000
DB_PATH=expondemand.db
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
ADMIN_PHONE=0821110000        # this number becomes the staff account
AUTO_VERIFY=false             # true = skip staff review (demo only)
# Optional: real AI intake. Without it a built-in keyword matcher is used.
ANTHROPIC_API_KEY=

# --- Hackathon demo deployment ---
# DEMO_MODE=true lets everyone sign in with the fixed code 123456 and shows a hint on screen. Use it ONLY for a public demo with fake data.
DEMO_MODE=false
# Origins allowed to call the API (website plus the packaged mobile app), comma separated
CORS_ORIGIN=https://demo.example.com,https://localhost,capacitor://localhost

# --- Real SMS (login codes). Default "outbox" sends nothing. ---
SMS_PROVIDER=outbox            # outbox | twilio | http
SMS_DAILY_CAP=500              # most login codes sent per day: protects you from SMS-pumping bills
# Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                   # a number or approved sender, e.g. +1555...   (or use the line below)
TWILIO_MESSAGING_SERVICE_SID=
# Any other provider with a JSON REST endpoint (Clickatell, BulkSMS, SMSPortal, Infobip):
SMS_HTTP_URL=
SMS_HTTP_HEADERS={"authorization":"Bearer YOUR_KEY"}
SMS_HTTP_BODY={"to":"{{to_digits}}","content":"{{text}}"}

# --- Business register check (CIPC) ---
REGISTRY_PROVIDER=none         # none | didit
DIDIT_API_KEY=
REGISTRY_AUTO_APPROVE=false    # true = a full register match approves the business without staff. Leave false unless you accept that
